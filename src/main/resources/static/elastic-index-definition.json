{
  "settings": {
    "analysis": {
      "tokenizer": {
        "nori_tokenizer": {
          "type": "nori_tokenizer",
          "decompound_mode": "mixed"
        }
      },
      "filter": {
        "nori_pos_filter": {
          "type": "nori_part_of_speech",
          "stoptags": [
            "E", "IC", "J", "MAG", "MAJ", "MM", "SP", "SSC", "SSO", "SC", "SE", "XPN", "XSA", "XSN", "XSV", "UNA", "NA", "VSV"
          ]
        },
        "icu_normalizer": {
          "type": "icu_normalizer",
          "name": "nfkc"
        },
        "synonym_filter": {
          "type": "synonym",
          "synonyms": [
            "아기, 유아",
            "학생, 제자",
            "구입, 구매",
            "예쁜, 아름다운",
            "슬픈, 우울한",
            "기질, 특성",
            "LA, 로스엔젤레스"
          ]
        }
      },
      "analyzer": {
        "korean_nori_analyzer": {
          "type": "custom",
          "tokenizer": "nori_tokenizer",
          "filter": [
            "nori_pos_filter",
            "lowercase",
            "icu_normalizer",
            "synonym_filter"
          ]
        },
        "korean_search": {
          "type": "custom",
          "tokenizer": "nori_tokenizer",
          "filter": [
            "nori_pos_filter",
            "lowercase",
            "icu_normalizer",
            "synonym_filter"
          ]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "false",
    "properties": {
      "id": { "type": "long" },
      "isbn": { "type": "keyword" },
      "title": {
        "type": "text",
        "analyzer": "korean_nori_analyzer",
        "fields": {
          "keyword": { "type": "keyword" }
        }
      },
      "volume": {
        "type": "text",
        "analyzer": "korean_nori_analyzer"
      },
      "description": {
        "type": "text",
        "analyzer": "korean_search"
      },
      "contributorNames": {
        "type": "text",
        "analyzer": "korean_nori_analyzer",
        "fields": {
          "keyword": { "type": "keyword" }
        }
      },
      "publisherNames": {
        "type": "text",
        "analyzer": "korean_nori_analyzer",
        "fields": {
          "keyword": { "type": "keyword" }
        }
      },
      "categoryIds": { "type": "keyword" },
      "categoryNames": {
        "type": "text",
        "analyzer": "korean_nori_analyzer",
        "fields": {
          "keyword": { "type": "keyword" }
        }
      },
      "tagNames": {
        "type": "text",
        "analyzer": "korean_nori_analyzer",
        "fields": {
          "keyword": { "type": "keyword" }
        }
      },
      "reviewContent": {
        "type": "text",
        "analyzer": "korean_search"
      },
      "publishDate": { "type": "date" },
      "priceStandard": { "type": "long" },
      "priceSales": { "type": "long" },
      "imagePath": {
        "type": "keyword",
        "index": false,
        "doc_values": false
      },
      "popularity": { "type": "long" },
      "reviewCount": { "type": "long" },
      "reviewRating": { "type": "double" },
      "embedding": {
        "type": "dense_vector",
        "dims": 1024,
        "index": true,
        "similarity": "cosine",
        "index_options": {
          "type": "hnsw",
          "m": 16,
          "ef_construction": 100
        }
      }
    }
  }
}